        "jsCode": "return $input.all().map(i => {\n  const r = i.json;\n  return { json: {\n    job_id: String(r.id),\n    title: r.title || '',\n    company: r.company_name || '',\n    location: r.candidate_required_location || '',\n    url: r.url || '',\n    description: (r.description || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 3000),\n    posted: r.publication_date || ''\n  }};\n});"
