      "parameters": {
        "jsCode": "const jobs = $input.all()\n  .map(i => i.json)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 10);\n\nconst text = jobs.map((j, n) =>\n  `${n + 1}. ${j.title} @ ${j.company} (${j.score}/100)\\n${j.reason}\\n${j.url}`\n).join('\\n\\n');\n\nreturn [{ json: { text: `Top job matches today:\\n\\n${text}` } }];"
      },
